# Build environment for the AppImage (scripts/build-appimage.sh runs it).
#
# Why a container: an AppImage runs on systems at least as new as the one it
# was built on (glibc). Building on Ubuntu 24.04 instead of a newer release
# lets it run on Ubuntu 24.04+, Debian 13+, Fedora 40+. (PySide6 6.12's
# ARM64 wheels need glibc 2.39, which is 24.04's, so this is as old as we can go.)
FROM docker.io/library/ubuntu:24.04

# build-essential, swig: compile PJSIP and its Python bindings
# libasound2-dev, libssl-dev, libopus-dev: PJSIP's audio, TLS and Opus codec
# patchelf: point the PJSIP module at the libraries we bundle
# file, xz-utils, curl: unpack and fetch the pinned downloads
# libgl1 ... libglib2.0: only for the smoke test that starts Qt offscreen
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential swig pkg-config \
        libasound2-dev libssl-dev libopus-dev \
        patchelf file xz-utils curl ca-certificates \
        libgl1 libegl1 libfontconfig1 libxkbcommon0 libdbus-1-3 libglib2.0-0t64 \
    && rm -rf /var/lib/apt/lists/*
